/*
 * C4 seed for a JSdotNet application (Structurizr DSL).
 * Copy into the project's .devbook/arc42/ and replace Contoso.Orders with the app's names.
 * The containers follow 05-building-block-view.md; the deployment follows ADR 0002.
 */
workspace "Contoso.Orders" "C4 seed from the JSdotNet application defaults." {

    !identifiers hierarchical

    model {
        user = person "User" "Uses the app in a browser."
        idp = softwareSystem "Identity provider" "External OIDC provider (ADR 0008)." "External"
        payments = softwareSystem "Payment provider" "An external service the app calls; replaced by a harness locally." "External"

        orders = softwareSystem "Contoso.Orders" "The application." {
            app = container "App" "The UI under src/App/ (ADR 0009)." "React + Vite or Blazor" "Web"
            api = container "Contoso.Orders.Api" "HTTP edge of the Orders module: endpoints, validation, Problem Details." "ASP.NET Core Minimal APIs" {
                endpoints = component "Endpoints" "One endpoint class per feature slice." "Minimal APIs"
                handlers = component "Feature handlers" "Commands and queries returning Result<T>." "Contoso.Orders"
                domain = component "Domain model" "Aggregates guarding the invariants." "Contoso.Orders"
                data = component "Data.Postgres" "EF Core repositories, migrations and outbox." "EF Core"
                worker = component "Notification worker" "Sends and retries stored notifications." "Hosted service"
            }
            migrations = container "MigrationRunner" "Applies every module's migrations, then exits." ".NET worker"
            db = container "orders-db" "The Orders module's schema, outbox and notifications." "Chosen in the app's ADR" "Database"
            files = container "orders-files" "File bytes behind IFileStorage." "Azure Blob Storage" "Storage"
        }

        user -> orders.app "Uses" "HTTPS"
        user -> idp "Signs in at" "OIDC"
        orders.app -> orders.api "Calls through the generated client" "HTTPS/JSON"
        orders.api.endpoints -> orders.api.handlers "Calls"
        orders.api.handlers -> orders.api.domain "Changes state through"
        orders.api.handlers -> orders.api.data "Loads and saves through ports"
        orders.api.data -> orders.db "Reads and writes" "EF Core"
        orders.api.worker -> orders.db "Claims due notifications"
        orders.api -> orders.files "Stores files" "Managed identity"
        orders.api -> payments "Charges" "HTTPS"
        orders.api -> idp "Validates tokens from"
        orders.migrations -> orders.db "Migrates"

        production = deploymentEnvironment "Azure" {
            deploymentNode "Azure Container Apps" "Generated by aspire publish, applied by aspire deploy." {
                containerInstance orders.app
                containerInstance orders.api
                containerInstance orders.migrations
            }
            deploymentNode "Azure database" "The provider the app chose." {
                containerInstance orders.db
            }
            deploymentNode "Azure Storage" {
                containerInstance orders.files
            }
        }
    }

    views {
        systemContext orders "Context" {
            include *
            autolayout lr
        }
        container orders "Containers" {
            include *
            autolayout lr
        }
        component orders.api "Api" {
            include *
            autolayout lr
        }
        deployment orders "Azure" "Deployment" {
            include *
            autolayout lr
        }
        styles {
            element "External" {
                background #999999
                color #ffffff
            }
            element "Database" {
                shape cylinder
            }
            element "Web" {
                shape WebBrowser
            }
        }
    }
}
