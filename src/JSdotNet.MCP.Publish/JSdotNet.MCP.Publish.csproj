<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>jsdotnet-publish-mcpserver</ToolCommandName>
    <PackageId>JSdotNet.MCP.Publish</PackageId>
    <Title>JSdotNet Publish Results MCP Server</Title>
    <Authors>Eduard Keilholz</Authors>
    <Company>JSdotNet</Company>
    <Description>Model Context Protocol (MCP) server that publishes agent results to a configurable file location. Integrates with GitHub Copilot and other MCP-compatible AI tools.</Description>
    <PackageProjectUrl>https://github.com/JSdotNet/Project-Guidelines-MCP</PackageProjectUrl>
    <RepositoryUrl>https://github.com/JSdotNet/Project-Guidelines-MCP</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>mcp;model-context-protocol;publish;results;dotnet;csharp;copilot</PackageTags>
    <Copyright>Copyright © Eduard Keilholz 2025</Copyright>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\JSdotNet.MCP.Shared\JSdotNet.MCP.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="ModelContextProtocol" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="JSdotNet.MCP.Publish.Tests" />
  </ItemGroup>

</Project>
