<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    
    <!-- NuGet Package Metadata -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>jsdotnet-guidelines-mcpserver</ToolCommandName>
    <PackageId>JSdotNet.MCP.Guidelines</PackageId>
    <Title>JSdotNet Project Guidelines MCP Server</Title>
    <Authors>Eduard Keilholz</Authors>
    <Company>JSdotNet</Company>
    <Description>Model Context Protocol (MCP) server providing access to JSdotNet project guidelines, ADRs, and best practices for .NET development. Integrates with GitHub Copilot and other MCP-compatible AI tools.</Description>
    <PackageProjectUrl>https://github.com/JSdotNet/Project-Guidelines-MCP</PackageProjectUrl>
    <RepositoryUrl>https://github.com/JSdotNet/Project-Guidelines-MCP</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>mcp;model-context-protocol;guidelines;adr;architecture;dotnet;csharp;copilot</PackageTags>
    <Copyright>Copyright © Eduard Keilholz 2025</Copyright>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\JSdotNet.MCP.Shared\JSdotNet.MCP.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="ModelContextProtocol" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
