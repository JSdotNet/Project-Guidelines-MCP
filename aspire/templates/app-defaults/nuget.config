<?xml version="1.0" encoding="utf-8"?>
<!-- ADR 0001: one source, and no version younger than 72 hours is picked automatically (NuGet 8.0, .NET SDK 11.0.100). -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" minPublishAgeHours="72" />
  </packageSources>
  <minPublishAgeExceptions />
</configuration>
