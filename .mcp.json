{
  "mcpServers": {
    "jsdotnet-app-defaults": {
      "type": "stdio",
      "command": "dotnet",
      "args": [
        "run",
        "--project",
        "src/JSdotNet.AppDefaults.Mcp/JSdotNet.AppDefaults.Mcp.csproj"
      ],
      "env": {
        "JSDOTNET_DOCS_PATH": "."
      },
      "tools": [
        "*"
      ]
    },
    "jsdotnet-publish-results": {
      "type": "stdio",
      "command": "dotnet",
      "args": [
        "run",
        "--project",
        "src/JSdotNet.MCP.Publish/JSdotNet.MCP.Publish.csproj",
        "--",
        "--Publish:RootPath=.publish"
      ],
      "tools": [
        "*"
      ]
    }
  }
}
